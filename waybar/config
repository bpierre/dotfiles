{
  "layer": "top",
  "height": 28,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": [
    "custom/rec",
    "battery",
    "wireplumber",
    "bluetooth",
    "network",
    "clock",
    "tray",
    "custom/close-app"
  ],
  "sway/workspaces": {
    "current-only": false,
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    },
    "sort-by-number": true
  },
  "sway/window": {
    "format": "{}",
    "max-length": 80,
    "tooltip": false,
    "rewrite": {
      "(.*) — Firefox Nightly": "$1 − Nightly"
    }
  },
  "battery": {
    "format": "PL {capacity}%",
    "format-charging": "PL {capacity}%",
    "format-discharging": "BA {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "full-at": 98,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "{:%d/%m/%y %H:%M}",
    "format-alt": "{:%a %H:%M}",
    "tooltip-format": "{:%A %d %B %Y at %H:%M}",
    "interval": 60
  },
  "custom/close-app": {
    "format": "×",
    "on-click": "swaymsg focus tiling && swaymsg kill"
  },
  "custom/rec": {
    "exec": "cat /tmp/rec-status 2>/dev/null",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "/home/pierre/bin/stt --gui --mode copy &",
    "on-click-right": "/home/pierre/bin/stt --toggle-lang"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 10,
    "show-passive-items": true
  },
  "wireplumber": {
    "format-icons": ["", "", ""],
    "format": "VO {volume}%",
    "format-muted": "VO MUT",
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-click-right": "pavucontrol",
    "on-click-middle": "helvum",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "max-volume": 100
  },
  "bluetooth": {
    "format": "",
    "format-off": "",
    "format-connected": "BL {device_alias}",
    "format-connected-battery": "BL {device_alias}",
    "format-device-preference": ["device1", "device2"],
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "max-length": 14
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "WI {essid}",
    "format-ethernet": "ET",
    "format-disconnected": "WI …",
    "format-disabled": "WI OFF",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 24
  }
}
