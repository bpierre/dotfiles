// Niri 26.04. Mod is Super in a session, Alt in a nested preview.
input {
    keyboard {
        xkb { file "~/dotfiles/sway/bepo-comma.xkb"; }
        repeat-delay 300
        repeat-rate 30
    }
    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
        accel-speed 0.1
    }
    mouse {
        accel-profile "adaptive"
        accel-speed -0.6
    }
    trackpoint { accel-speed -0.6; }
}

output "eDP-1" { scale 2; }
output "DP-1" {
    mode "3840x2160@30"
    scale 1
}

layout {
    gaps 0
    background-color "#000000"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        width 2
        // Match Sway: overlay2 / overlay0 / peach.
        active-color "#9399b2"
        inactive-color "#6c7086"
        urgent-color "#fab387"
    }
}
prefer-no-csd
screenshot-path null

animations {
    slowdown 0.5
}

// Keep the familiar numbered destinations; extra dynamic workspaces remain available.
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"

environment {
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORM "wayland"
    SDL_VIDEODRIVER "wayland"
    _JAVA_AWT_WM_NONREPARENTING "1"
}

// Bar, idle handling, OSD and polkit are managed by niri-specific systemd units.
spawn-at-startup "/home/pierre/bin/stt" "--init"
spawn-at-startup "/home/pierre/dotfiles/utils/update-mic-led.sh"

switch-events {
    lid-close { spawn "swaylock" "-f" "-c" "000000"; }
}

window-rule {
    match app-id="(?i)speedcrunch"
    match app-id="(?i)galculator"
    open-floating true
}
window-rule {
    match app-id="firefox" title=".*Bitwarden.*"
    match app-id="firefox" title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Files" { spawn "thunar"; }
    Mod+D hotkey-overlay-title="Application launcher" { spawn "/home/pierre/dotfiles/niri/launcher.sh"; }
    Mod+C { spawn "speedcrunch"; }
    Mod+I { spawn "hyprpicker" "--autocopy" "--lowercase-hex"; }
    Mod+W repeat=false { close-window; }
    Mod+Shift+S { spawn "/home/pierre/bin/stt" "--gui" "--mode" "copy"; }
    Mod+Shift+T { spawn "/home/pierre/bin/stt" "--gui" "--mode" "type"; }

    // Native screenshot picker: Space saves to clipboard, Escape cancels.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Super+Alt+L allow-when-locked=true { spawn "swaylock" "-f" "-c" "000000"; }
    Mod+Shift+E { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+F1 { show-hotkey-overlay; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+H { focus-workspace-up; }
    Mod+L { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Ctrl+Page_Up { move-window-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    // Bépo number row. Niri 26.04 bindings use the unshifted keysym, even with Shift.
    Mod+quotedbl { focus-workspace "1"; }
    Mod+guillemetleft { focus-workspace "2"; }
    Mod+guillemetright { focus-workspace "3"; }
    Mod+parenleft { focus-workspace "4"; }
    Mod+parenright { focus-workspace "5"; }
    Mod+at { focus-workspace "6"; }
    Mod+plus { focus-workspace "7"; }
    Mod+minus { focus-workspace "8"; }
    Mod+slash { focus-workspace "9"; }
    Mod+Shift+quotedbl { move-window-to-workspace "1"; }
    Mod+Shift+guillemetleft { move-window-to-workspace "2"; }
    Mod+Shift+guillemetright { move-window-to-workspace "3"; }
    Mod+Shift+parenleft { move-window-to-workspace "4"; }
    Mod+Shift+parenright { move-window-to-workspace "5"; }
    Mod+Shift+at { move-window-to-workspace "6"; }
    Mod+Shift+plus { move-window-to-workspace "7"; }
    Mod+Shift+minus { move-window-to-workspace "8"; }
    Mod+Shift+slash { move-window-to-workspace "9"; }

    Mod+F { fullscreen-window; }
    Mod+M { maximize-column; }
    Mod+T { toggle-column-tabbed-display; }
    Mod+V hotkey-overlay-title="Stack a window into this column" { consume-window-into-column; }
    Mod+B hotkey-overlay-title="Split a window into its own column" { expel-window-from-column; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space { switch-focus-between-floating-and-tiling; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && ~/dotfiles/utils/update-mic-led.sh"; }
}
